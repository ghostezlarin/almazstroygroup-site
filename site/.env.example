# Скопируйте этот файл в .env и заполните

# Случайная строка от 32 символов и пароль панели от 10 символов.
# На сервере сайт не запустится со стандартными значениями.
SECRET_KEY=
ADMIN_PASSWORD=

# Telegram: токен от @BotFather и chat_id получателя(ей) через запятую.
# chat_id можно узнать командой: python get_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Адрес сайта — нужен, чтобы в сообщении бота была ссылка на панель заявок
SITE_URL=http://127.0.0.1:5000

# Только для Docker: домен для автоматического HTTPS (например, example.ru).
# Без домена сайт работает по http на IP сервера.
# SITE_ADDRESS=example.ru

# По умолчанию SQLite (instance/site.db). Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/almazstroy
